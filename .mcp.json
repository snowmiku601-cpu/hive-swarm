        "post_message": { "approval_mode": "approve" },
        "pause_team": { "approval_mode": "approve" },
        "resume_team": { "approval_mode": "approve" },
        "wait_for_board": { "approval_mode": "approve" },
        "manage_channel": { "approval_mode": "approve" },
        "set_team_title": { "approval_mode": "approve" }
      }
    }
  }
